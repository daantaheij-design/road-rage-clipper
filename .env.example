# ============================================================================
# Road Rage Clipper — environment configuration
#
# Copy this file to `.env` for local development. On Railway, set these
# under Project -> Variables in the web dashboard (no terminal needed).
# ============================================================================

# ---- Private access -------------------------------------------------------
# Password required to open the /upload page from Safari. Pick something long
# and random - this is the only thing standing between the internet and your
# video pipeline.
APP_PASSWORD=change-me-to-a-long-random-password

# Random secret used to sign session cookies and temporary download links.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Bearer token required to call the MCP server tools remotely from Claude.
# Generate the same way as SECRET_KEY.
MCP_API_KEY=change-me-to-a-random-64-char-hex-string

# ---- Anthropic (video/story understanding) --------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Vision-capable Claude model used for frame analysis and storytelling.
# Defaults to the current flagship model - change only if you know what
# you're doing (e.g. to a cheaper model to reduce cost on long videos).
CLAUDE_MODEL=claude-opus-5

# Below this confidence, a visual-attention effect's target localization
# (the bounding box Claude reported for a circle/arrow/punch-zoom's subject)
# isn't trusted enough to draw an annotation pointing at it - a confident
# wrong guess (an arrow on the wrong car) is worse than no annotation.
EFFECTS_TARGET_CONFIDENCE_THRESHOLD=0.75

# ---- ElevenLabs (speech-to-text + voice-over) ------------------------------
ELEVENLABS_API_KEY=...
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Default narrator voice (George - male, narrative). Browse voices at
# https://elevenlabs.io/app/voice-library and paste a voice_id here.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Voice delivery (ElevenLabs voice_settings). Defaults aim for an energetic,
# expressive modern TikTok/Shorts narrator - not a calm documentary/news
# read. Lower stability = more emotional range/variation (less monotone);
# higher style = more exaggerated, character-driven delivery; speed slightly
# above 1.0 = a touch of urgency without sounding rushed. Tune these to
# taste - ranges are roughly 0-1 for stability/similarity/style and
# 0.7-1.2 for speed.
ELEVENLABS_VOICE_STABILITY=0.35
ELEVENLABS_VOICE_SIMILARITY=0.8
ELEVENLABS_VOICE_STYLE=0.55
ELEVENLABS_VOICE_SPEED=1.05

# ---- Storage (Cloudflare R2, S3-compatible) --------------------------------
# Leave these blank to fall back to local disk storage (fine for local
# testing; NOT recommended in production on Railway since disk is ephemeral).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=road-rage-clipper
# Optional override; normally derived from R2_ACCOUNT_ID as
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# ---- Retention / limits -----------------------------------------------------
# How long generated clips and source videos are kept before automatic
# deletion, in hours.
RETENTION_HOURS=48
# Hard cap on downloaded/uploaded source video size, in megabytes.
MAX_VIDEO_MB=500
# Hard cap on source video duration, in seconds (30 minutes default).
MAX_VIDEO_DURATION_SECONDS=1800

# Max threads ffmpeg/libx264 are allowed to use per render. Small containers
# (e.g. a default Railway service) report the *host's* full CPU count to
# ffmpeg, which will happily try to use all of it - and get OOM-killed doing
# so. 2 is a safe default; only raise this if you've also given the service
# more memory.
FFMPEG_THREADS=2

# ---- Misc --------------------------------------------------------------
# Public base URL of this deployment (used to build absolute links).
# Railway sets this automatically at build/runtime as RAILWAY_PUBLIC_DOMAIN;
# only set BASE_URL manually for local dev or a custom domain.
BASE_URL=http://localhost:8000
